{
  "name": "binary-version-reader",
  "version": "4.2.0",
  "main": "main.js",
  "exports": {
    ".": "./main.js",
    "./limited": "./limited.js"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=8.x"
  },
  "dependencies": {
    "@particle/device-os-protobuf": "^4.1.1",
    "archiver": "^8.0.0",
    "buffer-crc32": "^0.2.5",
    "unzipper": "^0.12.5"
  },
  "peerDependencies": {
    "@particle/device-constants": "^4.2.1"
  },
  "devDependencies": {
    "@particle/device-constants": "^4.2.1",
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:ci": "npm run coverage -- --allowOnly=false && npm run test:types",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:inspect": "vitest run --inspect-brk --no-file-parallelism",
    "coverage": "vitest run --coverage",
    "reinstall": "rm -rf ./node_modules && npm i",
    "build:types": "npm run clean:types && tsc6 --project ./tsconfig.build.json",
    "clean:types": "rm -f main.d.ts limited.d.ts lib/*.d.ts",
    "prepare": "npm run build:types",
    "test:types": "npm run build:types && tsc6 && tsc && tsc6 -p specs/types/tsconfig.commonjs.json && tsc -p specs/types/tsconfig.commonjs.json"
  },
  "bin": {
    "pmod": "bin/pmod.js"
  },
  "contributors": [
    {
      "name": "Eric Ely",
      "url": "https://github.com/eely22"
    }
  ],
  "types": "main.d.ts"
}
