{
	"name": "binary-version-reader",
	"version": "6.0.0-rc.2",
	"license": "Apache-2.0",
	"contributors": [
		{
			"name": "Eric Ely",
			"url": "https://github.com/eely22"
		}
	],
	"bin": {
		"pmod": "build/cli.js"
	},
	"files": [
		"build",
		"src"
	],
	"main": "build/main.js",
	"types": "build/main.d.ts",
	"exports": {
		".": "./build/main.js",
		"./limited": "./build/limited.js"
	},
	"scripts": {
		"test": "npm run test:unit",
		"test:ci": "npm run coverage -- --allowOnly=false",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:unit:inspect": "vitest run --inspect-brk --no-file-parallelism",
		"coverage": "vitest run --coverage",
		"reinstall": "rm -rf ./node_modules && npm i",
		"prepare": "npm run build",
		"build": "npm run clean && tsc -p tsconfig.build.json",
		"clean": "rm -rf build",
		"fmt": "oxfmt",
		"check": "tsc && oxlint --deny-warnings && oxfmt --check"
	},
	"dependencies": {
		"@particle/device-os-protobuf": "^4.1.1",
		"archiver": "^8.0.0",
		"buffer-crc32": "^0.2.5",
		"protobufjs": "^8.8.1",
		"unzipper": "^0.12.5"
	},
	"devDependencies": {
		"@particle/device-constants": "^4.2.1",
		"@particle/tooling": "^0.2.0",
		"@types/archiver": "^8.0.0",
		"@types/buffer-crc32": "^0.2.4",
		"@types/node": "^22.20.5",
		"@types/unzipper": "^0.10.11",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "^5.1.0",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"@particle/device-constants": "^4.2.1"
	},
	"engines": {
		"node": ">=22.23.4",
		"npm": ">=8.x"
	}
}
