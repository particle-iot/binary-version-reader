{
  "compilerOptions": {
    "noEmit": true,
    "target": "es2023",
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["specs/types/**/*.ts"]
}
